{
  "name": "webdev-erasmus",
  "version": "1.0.0",
  "description": "StudyHub: study groups and shared study sessions for students and exam candidates",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "migrate": "node --env-file-if-exists=.env src/scripts/migrate.js",
    "seed": "node --env-file-if-exists=.env src/scripts/seed.js",
    "test": "node --test",
    "coverage": "node --test --experimental-test-coverage --test-coverage-include='src/services/**' --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 && node --test --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-exclude='src/server.js' --test-coverage-exclude='src/scripts/**' --test-coverage-lines=80",
    "mcp": "node mcp-server/server.js",
    "mcp:token": "node --env-file-if-exists=.env src/scripts/mcp-token.js",
    "readiness": "node tools/readiness-check.mjs"
  },
  "dependencies": {
    "express": "^4.22.3",
    "pg": "^8.23.1",
    "pg-mem": "^3.0.14"
  },
  "engines": {
    "node": ">=22.9"
  }
}
