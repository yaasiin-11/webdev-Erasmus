# Every variable StudyHub reads. Copy this file to .env for local use: .env is in .gitignore.
# Real values never go into git. In a codespace, add the secret ones under
# Settings > Secrets and variables > Codespaces; on Render, under the service's Environment.

# Port the server listens on. Render sets it by itself.
PORT=3000

# Postgres connection string from the Neon dashboard (Connect > Connection string).
# "memory" runs an in-memory database filled with demo accounts: handy for a first look,
# but everything is lost on restart and the app refuses it when NODE_ENV=production.
DATABASE_URL=memory

# Signs the session cookie. Generate one with: openssl rand -hex 32
SESSION_SECRET=replace-with-openssl-rand-hex-32

# The address people open in the browser, without a trailing slash. Used for the Google
# redirect URI. Leave it empty in a codespace: the forwarded address is worked out for you.
PUBLIC_BASE_URL=

# "true" creates the three demo accounts on start if they do not exist yet.
SEED_DEMO=false

# Sign in with Google. Create an OAuth client (Web application) at console.cloud.google.com,
# keep it in Testing mode with yourself as a test user, and add <PUBLIC_BASE_URL>/api/auth/google/callback
# as an authorized redirect URI. Leave both empty to hide the Google button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The agenda suggestion. A free key comes from aistudio.google.com. Without it the app
# offers a standard agenda template instead.
GEMINI_API_KEY=
MODEL_NAME=gemini-2.5-flash-lite

# Password reset emails, sent through Brevo (free plan: 300 emails a day). Create an API key
# at app.brevo.com > SMTP & API, and verify the sender address under Senders. Without these two,
# the reset link is printed in the server log in development and not sent at all in production.
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=StudyHub

# Read by the MCP server only: create it with  npm run mcp:token -- <your email>
# The server acts as that user and can do exactly what that user can do.
MCP_TOKEN=
